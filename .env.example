# Placeholder for a local MongoDB. Copy this file to .env and change it if
# your server is not on the default port. Do not put real credentials here.
MONGODB_URI=mongodb://127.0.0.1:27017/digital_protocol

# Signs the session cookie. Replace this placeholder before any shared deployment.
SESSION_SECRET=local-dev-session-secret-change-me

# Optional directory for uploaded documents. The default is data/uploads on this
# machine. That folder is not part of the repository.
# UPLOAD_DIR=data/uploads

# Optional analyst assistant. Leave both unset to keep the summary button off.
# The URL receives a JSON brief and must respond with { "summary": "..." }.
# ANALYST_ASSISTANT_URL=
# ANALYST_ASSISTANT_API_KEY=
